<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net9.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <UseWindowsForms>true</UseWindowsForms>

        <!-- Self-contained Einstellungen -->
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <SelfContained>true</SelfContained>
        <PublishSingleFile>true</PublishSingleFile>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <PublishTrimmed>false</PublishTrimmed>

        <!-- Icon für die EXE -->
        <ApplicationIcon>app.ico</ApplicationIcon>
        
        <!-- Application Manifest for UAC elevation -->
        <ApplicationManifest>app.manifest</ApplicationManifest>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\SAFP.core\SAFP.core.csproj" />
        <Resource Include="app.ico" />
    </ItemGroup>

    <!-- Suppress implicit Windows Forms global usings to avoid ambiguity with System.Windows.* types.
         App.xaml.cs adds the necessary explicit usings where NotifyIcon is used. -->
    <ItemGroup>
        <Using Remove="System.Windows.Forms" />
        <Using Remove="System.Drawing" />
        <Using Remove="System.Drawing.Drawing2D" />
        <Using Remove="System.Drawing.Imaging" />
        <Using Remove="System.Drawing.Text" />
    </ItemGroup>

</Project>
